<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign chairs = data[1] | sort: 'date' | reverse %}
  {% for content in chairs %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-md-2 text-center date-column">
          {% if content.date %}
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ content.date }}</span>
          {% endif %}
        </div>
        <div class="col-md-10">
          <h6 class="title font-weight-bold">{{ content.title }}</h6>
          <p><strong>{{ content.event }}</strong><br/>{{ content.location }}</p>
          {% if content.note %}
            <p><em>{{ content.note }}</em></p>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>

