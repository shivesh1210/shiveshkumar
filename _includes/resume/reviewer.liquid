<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign reviewer = data[1] | sort: 'type' | reverse %}
  {% for content in reviewer %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% assign type = content.type %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ type }} </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <ul class="items">
            {% for item in content.journals %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>

          <ul class="items" style="list-style: none; padding-left: 0;">
            {% for item in content.conferences %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
